# The directory Mix will write compiled artifacts to.
/_build/

# If you run "mix test --cover", coverage assets end up here.
/cover/

# The directory Mix downloads your dependencies sources to.
/deps/

# Where third-party dependencies like ExDoc output generated docs.
/doc/

# Ignore .fetch files in case you like to edit your project deps locally.
/.fetch

# If the VM crashes, it generates a dump file in the CWD at the root of your project
erl_crash.dump

# Also ignore archive artifacts (built via "mix archive.build").
*.ez

# Ignore package tarball (built via "mix hex.build").
jump-*.tar

# Temporary files, for example, from tests.
*.tmp

# The directory NPM will write compiled assets to.
/assets/node_modules/

# Since we are building assets from assets/,
# we ignore the priv/static/assets directory.
# The compiled assets still need to be committed to version control.
# Do not ignore priv/static/assets. You may ignore the files (but not the directory).

# Files matching config/*.secret.exs pattern contain sensitive
# data and you should not commit them into version control.
/config/*.secret.exs

# Alternatively, you may comment the line below and commit the
# secrets files as long as you replace their contents by environment
# variables.
/config/*.secret.exs

# Environment files
.env
.env.local
.env.*.local

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

